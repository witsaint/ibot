{
  "name": "@i-bot/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.node.json",
    "dev": "tsc -p tsconfig.node.json --watch",
    "check-types": "tsc --noEmit -p tsconfig.node.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "verify:sandbox": "tsx scripts/verify-sandbox.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@i-bot/logger": "workspace:*",
    "@i-bot/templates": "workspace:*",
    "@i-bot/types": "workspace:*",
    "@mastra/core": "^1.66.0",
    "ai": "^7.0.97",
    "playwright-core": "^1.63.0",
    "ppio-sandbox": "^2.1.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@i-bot/config": "workspace:*",
    "@types/node": "^24.13.4",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
