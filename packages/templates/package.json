{
  "name": "@i-bot/templates",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "desktop"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.node.json",
    "dev": "tsc -p tsconfig.node.json --watch",
    "check-types": "tsc --noEmit -p tsconfig.node.json",
    "template:build": "./desktop/build.sh",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@i-bot/config": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
