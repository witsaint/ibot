{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  },
  "globalEnv": ["CI"],
  "globalPassThroughEnv": [
    "AIPROXY_API_KEY",
    "PPIO_API_KEY",
    "SANDBOX_CONTROL_PLANE_URL",
    "SANDBOX_CHANNEL_SLUG",
    "ANTHROPIC_API_KEY",
    "DATABASE_URL",
    "REDIS_URL"
  ]
}
